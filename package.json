{
  "name": "@sethwebster/consensus",
  "version": "0.1.0",
  "description": "Ask one prompt to many AI model CLIs in parallel, then synthesize a canonical answer.",
  "type": "module",
  "bin": {
    "consensus": "dist/cli.js",
    "consensus-skill": "scripts/install-skill.mjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skill",
    "scripts/install-skill.mjs",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sethwebster/consensus.git"
  },
  "homepage": "https://github.com/sethwebster/consensus#readme",
  "bugs": {
    "url": "https://github.com/sethwebster/consensus/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "skill:install": "node scripts/install-skill.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \"test/**/*.test.ts\"",
    "test:only": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build",
    "release": "semantic-release"
  },
  "keywords": [
    "ai",
    "cli",
    "llm",
    "ensemble",
    "consensus",
    "claude",
    "codex",
    "gemini",
    "ollama"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "ink": "^7.1.1",
    "picocolors": "^1.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "semantic-release": "^25.0.8",
    "typescript": "^5.7.0"
  }
}
